{
  "name": "waraqati-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Waraqati Studio — arrange, create, and prepare images for printing.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "check": "tsc -p tsconfig.app.json --pretty && tsc -p tsconfig.node.json --pretty",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}